{
  "name": "xelanote-frontend",
  "version": "0.1.0",
  "private": true,
  "author": "xelanote",
  "description": "Personal note-taking with wikilinks",
  "homepage": "https://xelanote.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/xela-io/xelanote.git"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:local": "vite dev --port 5173 --strictPort",
    "dev:prod": "VITE_API_BASE_URL=/api VITE_API_PROXY_TARGET=https://xelanote.com vite dev --port 5173 --strictPort",
    "build": "vite build",
    "analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint:md": "markdownlint-cli2 '../README.md' '../docs/**/*.md' '../CHANGELOG.md' '../ROADMAP.md'",
    "test:e2e": "NODE_OPTIONS='--require ts-node/register --require tsconfig-paths/register' playwright test",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon",
    "electron:dev": "TMPBASE=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}; mkdir -p \"$TMPBASE/xelanote-tmp\" && TMPDIR=\"$TMPBASE/xelanote-tmp\" TMP=\"$TMPBASE/xelanote-tmp\" TEMP=\"$TMPBASE/xelanote-tmp\" concurrently -k \"vite dev --port 5173 --strictPort\" \"sleep 2 && NODE_ENV=development electron-vite dev --ignoreConfigWarning\"",
    "electron:dev:prod": "TMPBASE=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}; mkdir -p \"$TMPBASE/xelanote-tmp\" && TMPDIR=\"$TMPBASE/xelanote-tmp\" TMP=\"$TMPBASE/xelanote-tmp\" TEMP=\"$TMPBASE/xelanote-tmp\" VITE_API_BASE_URL=/api VITE_API_PROXY_TARGET=https://xelanote.com concurrently -k \"vite dev --port 5173 --strictPort\" \"sleep 2 && NODE_ENV=development electron-vite dev --ignoreConfigWarning\"",
    "electron:build": "npm run build && electron-vite build && electron-builder",
    "electron:build:linux": "npm run build && electron-vite build && electron-builder --linux",
    "electron:preview": "electron-vite preview"
  },
  "main": "dist-electron/main/index.js",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.49.1",
    "@rollup/plugin-json": "^6.1.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/svelte": "^5.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.0.9",
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.5.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "markdownlint-cli2": "^0.20.0",
    "otpauth": "^9.4.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "rollup-plugin-visualizer": "^6.0.0",
    "svelte": "^5.2.0",
    "svelte-check": "^4.1.0",
    "svelte-eslint-parser": "^1.0.0",
    "svelte-i18n": "^4.0.0-next.1",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.17",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "cookie": "^1.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@fontsource/inter": "^5.2.8",
    "@lezer/markdown": "^1.3.2",
    "@noble/hashes": "^2.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/svelte-virtual": "^3.13.18",
    "@tauri-apps/api": "^2",
    "@xyflow/svelte": "^1.5.0",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "focus-trap": "^7.8.0",
    "force-graph": "^1.51.0",
    "isomorphic-dompurify": "^2.35.0",
    "libsodium-wrappers": "^0.8.1",
    "lucide-svelte": "^0.462.0",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "minisearch": "^7.2.0",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.6",
    "tailwind-merge": "^2.5.5",
    "web-vitals": "^5.1.0"
  },
  "type": "module"
}
