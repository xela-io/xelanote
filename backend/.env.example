# =============================================================================
# xelanote Environment Configuration
# =============================================================================
# Copy to .env and adjust values for your deployment.
# Full reference: docs/environment-variables.md

# --- Required ---

# JWT Secret (minimum 64 characters, cryptographically secure)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# CORS allowed origins (required in production, comma-separated)
# Example: https://notes.example.com,https://backup.example.com
# CORS_ALLOWED_ORIGINS=https://notes.example.com

# --- Database ---

# Database path (default: ./data/xelanote.db)
# XELANOTE_DB=./data/xelanote.db

# Database encryption (SQLCipher) - leave empty to disable
# XELANOTE_DB_KEY=
# XELANOTE_DB_KEY_FILE=/run/secrets/db_key

# --- Environment ---

# Environment mode: development | production
# Affects: cookie Secure flag, SameSite policy, WebAuthn defaults
# XELANOTE_ENV=development

# Secret for encrypting stored API keys (falls back to JWT_SECRET if not set)
# XELANOTE_API_KEY_SECRET=

# --- Security ---

# Trusted reverse proxy IPs (comma-separated, for X-Forwarded-For)
# TRUSTED_PROXIES=127.0.0.1,::1

# WebAuthn/FIDO2 Relying Party configuration
# Required in production. Defaults to localhost in development.
# WEBAUTHN_RP_ID=notes.example.com
# WEBAUTHN_RP_ORIGINS=https://notes.example.com

# Cloudflare Turnstile CAPTCHA (leave empty to disable)
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# --- AI/LLM ---

# Override default Gemini model (default: gemini-2.5-flash)
# API keys are configured per-user in Settings, not here.
# GEMINI_MODEL=gemini-2.5-flash

# --- Integrations ---

# Forgejo error reporting (leave empty to disable)
# FORGEJO_URL=https://git.example.com
# FORGEJO_REPO=owner/repo
# FORGEJO_API_TOKEN=

# --- Debugging ---

# Enable Go pprof profiling (default: false, binds to 127.0.0.1:6060)
# PPROF_ENABLED=false
